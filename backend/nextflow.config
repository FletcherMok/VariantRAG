manifest {
    name = 'VariantRAG'
    version = '0.2.0'
    nextflowVersion = '>=25.04.0'
}
params {
    workflow = 'run'
    genome_build = 'GRCh38'
    mode = 'research'
    vcf = null
    literature = null
    sample = null
    bundles = null
    outdir = 'results/nextflow'
    python = 'python'
    catt_checkout = null
    catt_revision = null
    catt_variant_ids = null
}
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    errorStrategy = 'terminate'
}
env.PYTHONPATH = "${projectDir}"
profiles {
    docker {
        docker.enabled = true
        process.container = 'variantrag:0.2.0'
        env.PYTHONPATH = '/app/backend'
    }
    demo {
        params.vcf = "${projectDir}/../tests/fixtures/demo.vcf"
        params.literature = "${projectDir}/../tests/fixtures/demo_literature.json"
        params.mode = 'demo'
    }
}
trace {
    enabled = true
    file = "${params.outdir}/trace.tsv"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/report.html"
    overwrite = true
}
